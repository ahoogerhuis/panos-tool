# PAN-OS credentials
#
# Checked in this order, first match wins (no directory traversal):
#   1. .env               — plain, in the current directory
#   2. ~/.env.panos-tool  — script-specific, in your home directory
#   3. ~/.env              — generic, in your home directory
#
# Copy this file to one of those paths and fill in your values. The
# home-directory tiers are useful for running from cron or from any
# directory without a project-local .env; the script-specific one lets
# you keep credentials for several tools in one shared ~/.env but
# override just this one.
#
# PANOS_USERNAME is required if you don't pass -u/--username on the command
# line — there is no implicit default account.
PANOS_USERNAME=your-admin-username
PANOS_PASSWORD=YourSecurePasswordHere

# --automatic/--yolo options (both required to use --automatic)
#
# Day of week --automatic is allowed to do anything on (e.g. sunday).
# Any other day it's a no-op. Meant to be invoked daily by cron; the
# script decides whether today is the day, not the crontab entry.
PANOS_AUTOMATIC_WEEKDAY=
#
# Minimum age, in days, a newer hotfix must have before --automatic will
# auto-install it ("let it bake" window).
PANOS_AUTOMATIC_MIN_AGE_DAYS=
#
# How many most-recent versions to keep per hotfix train when pruning
# (the base version counts against this number). Optional, defaults to 3.
PANOS_AUTOMATIC_KEEP_VERSIONS=

# --reboot-pending options (both optional, defaults shown)
#
# Daily reboot window start (HH:MM) for devices --automatic marked
# pending. --reboot-pending only reboots a device if invoked while
# inside [start, start+length) today; outside it, the device just
# waits for the next invocation (or tomorrow's window, if this one
# closes first).
PANOS_AUTOMATIC_REBOOT_WINDOW_START=02:00
#
# Reboot window length. A number with a unit suffix: 30s, 30m, or 1h.
# This is also effectively your processing budget for a large pending
# list, since --reboot-pending handles devices sequentially.
PANOS_AUTOMATIC_REBOOT_WINDOW_LENGTH=30m

# Set to 1 to enable debug logging to debug.log (same as --debug-log)
DEBUG_TO_FILE=
